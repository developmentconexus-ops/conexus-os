node_modules/
# Without this line the pattern above matches only a real directory, so a worktree that links its
# dependencies with a symlink named node_modules gets it committed by `git add -A`.
node_modules
apps/hub/public/
dist/
!packages/contract/dist/
coverage/
*.log
.env
.env.*
!.env.example
.worktrees/
.audit/
apps/hub/.conexus-build-*/
apps/hub/*-build-*/
.DS_Store
# Claude Code keeps local state here (launch.json, locks, worktrees).
.claude/*
# Except project skills: each is a link to its source in .agents/skills.
!.claude/skills/
.artifacts/

# Scratch static builds a browser test writes under apps/web
apps/web/test-static-*
