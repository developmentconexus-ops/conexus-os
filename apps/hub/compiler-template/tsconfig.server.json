{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "typeRoots": [
      "/opt/conexus/compiler/full/node_modules/@types"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "/workspace/conexus"
  ]
}
