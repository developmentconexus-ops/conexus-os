{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "typeRoots": [
      "/opt/conexus/compiler/node_modules",
      "/opt/conexus/compiler/node_modules/@types"
    ],
    "paths": {
      "@/*": [
        "/workspace/app/src/*"
      ]
    }
  },
  "include": [
    "/workspace/app"
  ]
}
