{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conexus:project-scaffold-profile:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "profileId", "profileVersion", "generatorProtocolVersion", "outputs"],
  "properties": {
    "kind": { "const": "conexus.project-scaffold-profile/v1" },
    "profileId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "profileVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generatorProtocolVersion": { "const": "ConexusProfileCompiler/v1" },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "class", "render", "content"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "class": { "enum": ["GENERATED", "PLATFORM-CONTRACT", "APP-OWNED"] },
              "render": { "const": "STATIC" },
              "content": { "type": "string" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "class", "render", "inputKey"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "class": { "enum": ["GENERATED", "PLATFORM-CONTRACT"] },
              "render": { "enum": ["CANONICAL_JSON", "R1_OPERATION_MODULE"] },
              "inputKey": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    }
  }
}
