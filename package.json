{
  "name": "conexus-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0",
    "npm": "12.0.2"
  },
  "scripts": {
    "test": "npm run verify",
    "test:live": "node --test --test-isolation=none --test-global-setup=tests/live/harness.mjs tests/live/builder-send-and-reply.test.mjs tests/live/builder-ask-and-answer.test.mjs tests/live/builder-park-and-answer.test.mjs tests/live/builder-reload-while-parked.test.mjs tests/live/builder-question-card.test.mjs tests/live/builder-second-question.test.mjs tests/live/builder-typing-while-parked.test.mjs tests/live/builder-done-gate.test.mjs tests/live/project-delete-wrong-name.test.mjs tests/live/identity-sign-out-asks-password.test.mjs",
    "conexus:preflight": "node scripts/conexus-preflight.mjs",
    "conexus:verify": "node scripts/conexus-verify.mjs",
    "db:roles:generate": "node scripts/generate-hub-role-register.mjs",
    "db:roles:check": "node scripts/generate-hub-role-register.mjs --check && node --test tests/implementation/hub-role-register.test.mjs tests/implementation/connection-census.test.mjs",
    "db:roles:census": "node scripts/provision-hub-roles.mjs --check",
    "db:roles:provision": "node scripts/provision-hub-roles.mjs",
    "iam:bootstrap-installation-administrator": "node scripts/bootstrap-installation-administrator.mjs",
    "db:roles:postgres": "node --test --test-concurrency=1 tests/implementation/provision-hub-roles.test.mjs tests/implementation/protected-cluster-coverage.test.mjs",
    "db:baseline:generate": "node scripts/generate-hub-baseline.mjs",
    "db:baseline:check": "node scripts/generate-hub-baseline.mjs --check",
    "db:catalog:snapshot": "node scripts/generate-hub-catalog-snapshot.mjs",
    "db:catalog:check": "node scripts/generate-hub-catalog-snapshot.mjs --check",
    "repository:check": "node scripts/check-agent-context.mjs && node --test tests/repository/conexus-verify.test.mjs",
    "worktree:reap": "node scripts/worktree-reap.mjs",
    "worktree:new": "node scripts/worktree-new.mjs",
    "typecheck:web": "node node_modules/typescript/bin/tsc --project apps/web/tsconfig.json --pretty false",
    "web:style:check": "node scripts/check-web-style.mjs",
    "keycloak-theme:check": "cd apps/keycloak-theme && npm run typecheck && npm run build",
    "generate:iam": "node scripts/generate-iam-contracts.mjs",
    "generate:workspace": "node scripts/generate-workspace-contracts.mjs",
    "generate:project": "node scripts/generate-project-contracts.mjs",
    "generate:connector": "node scripts/generate-connector-contracts.mjs",
    "check:contracts": "node scripts/generate-iam-contracts.mjs --check && node scripts/generate-workspace-contracts.mjs --check && node scripts/generate-project-contracts.mjs --check && node scripts/generate-connector-contracts.mjs --check",
    "typecheck:hub": "node node_modules/typescript/bin/tsc --project apps/hub/tsconfig.json --pretty false",
    "test:import-law": "node --test --test-concurrency=1 tests/repository/import-law.test.mjs",
    "builder:starter:components": "node scripts/generate-starter-components.mjs",
    "builder:template:check": "node scripts/builder-e2b-template.mjs --check && node --test --test-concurrency=1 tests/implementation/builder-e2b-template.test.mjs tests/implementation/builder-e2b-live.test.mjs",
    "builder:template:live": "CONEXUS_E2B_TEMPLATE_LIVE=true node --test --test-concurrency=1 tests/implementation/builder-e2b-live.test.mjs",
    "hub:local": "node --env-file=\"${CONEXUS_HUB_ENV:?set CONEXUS_HUB_ENV}\" scripts/build-hub-local.mjs",
    "builder:sandbox:live": "CONEXUS_FACTORY_LIVE=true node --env-file=\"${CONEXUS_HUB_ENV:?set CONEXUS_HUB_ENV}\" --test --test-concurrency=1 tests/implementation/builder-sandbox-e2b-live.test.mjs",
    "builder:composed:live": "CONEXUS_COMPOSED_LIVE=true node --env-file=\"${CONEXUS_HUB_ENV:?set CONEXUS_HUB_ENV}\" tests/implementation/builder-production-composed-live-runner.mjs",
    "wire:lint": "npx --yes @redocly/cli@2.47.0 lint contracts/api/product/openapi.yaml --extends=recommended",
    "wire:bundle": "npx --yes @redocly/cli@2.47.0 bundle contracts/api/product/openapi.yaml --output=/tmp/conexus-product-openapi.bundle.json --ext=json",
    "wire:bijection": "node scripts/check-wire-bijection.mjs",
    "wire:carriers": "node scripts/check-wire-carriers.mjs",
    "wire:identity-workspace": "node scripts/check-wire-identity-workspace.mjs",
    "wire:project": "node scripts/check-wire-project.mjs",
    "wire:builder": "node scripts/check-wire-builder.mjs",
    "wire:connector": "node scripts/check-wire-connector.mjs",
    "wire:technical-lint": "npx --yes @redocly/cli@2.47.0 lint contracts/api/technical/openapi.yaml --extends=recommended",
    "wire:technical-ingress": "node scripts/check-wire-technical-ingress.mjs",
    "wire:verify": "npm run wire:lint && npm run wire:bundle && npm run wire:bijection && npm run wire:carriers && npm run wire:identity-workspace && npm run wire:project && npm run wire:builder && npm run wire:connector && npm run wire:technical-lint && npm run wire:technical-ingress",
    "verify": "npm run conexus:verify -- --scope candidate",
    "verify:docs": "npm run conexus:verify -- --scope candidate-docs",
    "verify:quick": "npm run conexus:verify -- --scope candidate-quick"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.118",
    "@ai-sdk/google": "2.0.97",
    "@ai-sdk/openai": "3.0.114",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/otel": "0.21.0",
    "@fastify/static": "10.1.3",
    "@mastra/client-js": "1.50.0",
    "@mastra/code-sdk": "1.8.3",
    "@mastra/core": "1.71.0",
    "@mastra/e2b": "0.12.1",
    "@mastra/fastify": "1.5.15",
    "@mastra/libsql": "1.23.3",
    "@mastra/mcp": "2.1.0",
    "@mastra/memory": "1.32.1",
    "@mastra/observability": "1.18.1",
    "@mastra/pg": "1.27.1",
    "@mastra/playground-ui": "55.0.0",
    "@mastra/react": "1.5.0",
    "@mastra/server": "1.71.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/instrumentation-http": "0.221.0",
    "@opentelemetry/instrumentation-pg": "0.73.0",
    "@opentelemetry/instrumentation-pino": "0.67.0",
    "@opentelemetry/instrumentation-runtime-node": "0.34.0",
    "@opentelemetry/instrumentation-undici": "0.31.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@uiw/react-codemirror": "4.25.11",
    "ai": "6.0.286",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "4.0.0",
    "diff": "8.0.4",
    "e2b": "2.46.1",
    "fastify": "5.12.1",
    "lucide-react": "1.47.0",
    "openid-client": "6.8.7",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.4",
    "undici": "7.29.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "@mastra/react": {
      "@mastra/client-js": "$@mastra/client-js"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@redocly/cli": "2.47.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "knip": "6.38.0",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.2.2"
  }
}
