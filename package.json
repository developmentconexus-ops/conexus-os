{
  "name": "conexus-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0",
    "npm": "12.0.2"
  },
  "workspaces": [
    "packages/contract"
  ],
  "scripts": {
    "test": "npm run verify",
    "test:live": "bash scripts/test-with-ledger.sh --test-isolation=none --test-global-setup=tests/live/harness.mjs 'tests/live/*.test.mjs'",
    "conexus:preflight": "node scripts/conexus-preflight.mjs",
    "db:roles:generate": "node scripts/generate-hub-role-register.mjs",
    "db:roles:check": "node scripts/generate-hub-role-register.mjs --check",
    "db:roles:census": "node scripts/provision-hub-roles.mjs --check",
    "db:roles:provision": "node scripts/provision-hub-roles.mjs",
    "db:roles:postgres": "bash scripts/test-with-ledger.sh --test-concurrency=1 tests/implementation/provision-hub-roles.postgres.test.mjs tests/implementation/protected-cluster-coverage.test.mjs",
    "db:baseline:generate": "node scripts/generate-hub-baseline.mjs",
    "db:baseline:check": "node scripts/generate-hub-baseline.mjs --check",
    "db:catalog:snapshot": "node scripts/generate-hub-catalog-snapshot.mjs",
    "db:catalog:check": "node scripts/generate-hub-catalog-snapshot.mjs --check",
    "db:callers": "node scripts/function-callers.mjs",
    "db:callers:check": "node scripts/function-callers.mjs --check",
    "repository:check": "node scripts/check-agent-context.mjs",
    "worktree:reap": "node scripts/worktree-reap.mjs",
    "worktree:new": "node scripts/worktree-new.mjs",
    "typecheck:web": "node node_modules/typescript/bin/tsc --project apps/web/tsconfig.json --pretty false",
    "web:style:check": "node scripts/check-web-style.mjs",
    "keycloak-theme:check": "cd apps/keycloak-theme && npm run typecheck && npm run build",
    "generate": "node scripts/generate-failures.mjs && node scripts/generate-builder-run-vocabulary.mjs && node scripts/generate-log-codes.mjs && node scripts/generate-hub-role-register.mjs && npm run contract:build && npm run contract:emit",
    "contract:build": "node node_modules/typescript/bin/tsc --project packages/contract/tsconfig.json --pretty false",
    "contract:emit": "node scripts/emit-openapi.mjs",
    "contract:check": "node scripts/emit-openapi.mjs --check",
    "contract:dist:check": "node scripts/check-contract-dist.mjs",
    "typecheck:hub": "node node_modules/typescript/bin/tsc --project apps/hub/tsconfig.json --pretty false",
    "test:import-law": "bash scripts/test-with-ledger.sh --test-concurrency=1 tests/repository/import-law.test.mjs",
    "builder:starter:components": "node scripts/generate-starter-components.mjs",
    "builder:template:check": "node scripts/builder-e2b-template.mjs --check && bash scripts/test-with-ledger.sh --test-concurrency=1 tests/implementation/builder-e2b-template.test.mjs tests/manual/builder-e2b-live.test.mjs",
    "builder:template:live": "CONEXUS_E2B_TEMPLATE_LIVE=true bash scripts/test-with-ledger.sh --test-concurrency=1 tests/manual/builder-e2b-live.test.mjs",
    "hub:local": "node --env-file=\"${CONEXUS_HUB_ENV:?set CONEXUS_HUB_ENV}\" scripts/build-hub-local.mjs",
    "builder:sandbox:live": "CONEXUS_FACTORY_LIVE=true bash scripts/test-with-ledger.sh --env-file=\"${CONEXUS_HUB_ENV:?set CONEXUS_HUB_ENV}\" --test-concurrency=1 tests/manual/builder-sandbox-e2b-live.test.mjs",
    "builder:question:live": "CONEXUS_FACTORY_LIVE=true bash scripts/test-with-ledger.sh --env-file=\"${CONEXUS_HUB_ENV:?set CONEXUS_HUB_ENV}\" --test-concurrency=1 tests/manual/builder-question-e2b-live.test.mjs",
    "builder:question:heap": "bash scripts/test-with-ledger.sh tests/manual/builder-question-heap.test.mjs",
    "builder:composed:live": "CONEXUS_COMPOSED_LIVE=true node --env-file=\"${CONEXUS_HUB_ENV:?set CONEXUS_HUB_ENV}\" tests/implementation/builder-production-composed-live-runner.mjs",
    "builder:eval": "bash scripts/test-with-ledger.sh --test-concurrency=1 'tests/manual/builder-eval-!(*.postgres).test.mjs'",
    "builder:eval:postgres": "bash scripts/test-with-ledger.sh --test-concurrency=1 'tests/manual/builder-eval-*.postgres.test.mjs'",
    "wire:lint": "npx --no-install redocly lint contracts/api/product/openapi.json --extends=recommended",
    "wire:bijection": "node scripts/check-wire-bijection.mjs",
    "wire:technical-lint": "npx --no-install redocly lint contracts/api/technical/openapi.yaml --extends=recommended",
    "wire:verify": "npm run wire:lint && npm run wire:bijection && npm run wire:technical-lint",
    "verify": "export CONEXUS_HUB_BUILD=\"${CONEXUS_HUB_BUILD:-$PWD/node_modules/.cache/conexus-hub-build}\" && npm run checks:static && npm run wire:verify && npm run builder:template:check && npm run web:style:check && npm run build:hub && npm run build:web && npm run test:unit && npm run test:network && npm run test:postgres && npm run test:browser && npm run test:smoke",
    "verify:docs": "npm run repository:check && npm run wire:bijection && npm run test:repository",
    "verify:quick": "npm run checks:static && npm run typecheck:hub",
    "build:hub": "node node_modules/typescript/bin/tsc --project apps/hub/tsconfig.json --pretty false --noEmit false --outDir \"${CONEXUS_HUB_BUILD:-node_modules/.cache/conexus-hub-build}\" && node scripts/build-app-check.mjs \"${CONEXUS_HUB_BUILD:-node_modules/.cache/conexus-hub-build}\"",
    "build:web": "node node_modules/vite/bin/vite.js build --config apps/web/vite.config.mjs apps/web --outDir \"${CONEXUS_WEB_BUILD:-../../node_modules/.cache/public}\" --emptyOutDir",
    "lint": "npx --no-install biome ci . --error-on-warnings && npx --no-install knip",
    "boundaries:check": "node scripts/check-import-law.mjs && node scripts/check-access-owner.mjs && node scripts/check-boundaries.mjs && node scripts/check-builder-safety.mjs && node scripts/check-error-model.mjs --check && node scripts/check-model-account-census.mjs",
    "generated:check": "npm run contract:dist:check && npm run generate && git diff --exit-code -- packages/contract/dist packages/contract/src/failures.generated.ts packages/contract/src/builder-run-vocabulary.ts apps/hub/src/generated apps/web/src/generated apps/hub/src/telemetry/log-codes.generated.ts apps/hub/src/platform/hub-roles.generated.ts contracts/api/product/openapi.json",
    "verify:qualification": "export CONEXUS_HUB_BUILD=\"${CONEXUS_HUB_BUILD:-$PWD/node_modules/.cache/conexus-hub-build}\" && npm run verify && npm run test:live:extended && npm run test:backup",
    "test:repository": "bash scripts/test-with-ledger.sh 'tests/repository/!(*.browser|*.postgres).test.mjs'",
    "test:unit": "bash scripts/test-with-ledger.sh 'tests/repository/!(*.browser|*.postgres).test.mjs' 'tests/implementation/!(*.browser|*.postgres|*.network|conexus-backup).test.mjs' 'tests/implementation/access/*.test.mjs'",
    "test:postgres": "npm run db:catalog:check && npm run db:callers:check && npm run db:baseline:check && bash scripts/test-with-ledger.sh --test-concurrency=1 'tests/implementation/*.postgres.test.mjs'",
    "test:browser": "bash scripts/test-with-ledger.sh --test-concurrency=1 ${CONEXUS_TEST_SHARD:+--test-shard=$CONEXUS_TEST_SHARD} 'tests/implementation/*.browser.test.mjs'",
    "test:smoke": "bash scripts/test-with-ledger.sh --test-isolation=none --test-global-setup=tests/live/harness.mjs tests/live/builder-ask-and-answer.test.mjs tests/live/builder-done-gate.test.mjs tests/live/identity-sign-out-asks-password.test.mjs tests/live/project-delete-wrong-name.test.mjs",
    "test:backup": "bash scripts/test-with-ledger.sh tests/implementation/conexus-backup.test.mjs",
    "test:live:extended": "bash scripts/test-with-ledger.sh --test-isolation=none --test-global-setup=tests/live/harness.mjs tests/live/builder-question-card.test.mjs tests/live/builder-reload-while-waiting.test.mjs tests/live/builder-run-failure.test.mjs tests/live/builder-second-question.test.mjs tests/live/builder-send-and-reply.test.mjs tests/live/builder-typing-while-waiting.test.mjs tests/live/builder-wait-and-answer.test.mjs",
    "checks:static": "npm run conexus:preflight && npm run typecheck:web && npm run repository:check && npm run boundaries:check && npm run generated:check && npm run lint",
    "test:network": "bash scripts/test-with-ledger.sh --test-concurrency=1 'tests/implementation/*.network.test.mjs'"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.118",
    "@ai-sdk/google": "2.0.97",
    "@ai-sdk/openai": "3.0.114",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@conexus/contract": "0.1.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/otel": "0.21.0",
    "@fastify/static": "10.1.3",
    "@mastra/client-js": "1.50.0",
    "@mastra/code-sdk": "1.8.3",
    "@mastra/core": "1.71.0",
    "@mastra/e2b": "0.12.1",
    "@mastra/fastify": "1.5.15",
    "@mastra/libsql": "1.23.3",
    "@mastra/mcp": "2.1.0",
    "@mastra/memory": "1.32.1",
    "@mastra/observability": "1.18.1",
    "@mastra/pg": "1.27.1",
    "@mastra/playground-ui": "55.0.0",
    "@mastra/react": "1.5.0",
    "@mastra/server": "1.71.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/instrumentation-http": "0.221.0",
    "@opentelemetry/instrumentation-pg": "0.73.0",
    "@opentelemetry/instrumentation-pino": "0.67.0",
    "@opentelemetry/instrumentation-runtime-node": "0.34.0",
    "@opentelemetry/instrumentation-undici": "0.31.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@uiw/react-codemirror": "4.25.11",
    "ai": "6.0.286",
    "canonicalize": "4.0.0",
    "diff": "8.0.4",
    "e2b": "2.46.1",
    "fastify": "5.12.1",
    "lucide-react": "1.47.0",
    "openid-client": "6.8.7",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.4",
    "undici": "7.29.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "@mastra/react": {
      "@mastra/client-js": "$@mastra/client-js"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@redocly/cli": "2.47.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "knip": "6.38.0",
    "lightningcss": "1.33.0",
    "playwright": "1.62.1",
    "rolldown": "1.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.2.2"
  }
}
