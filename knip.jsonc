{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    // Scripts that are run but never imported, and that no package.json script names. Name each one:
    // package.json scripts are already roots, and a directory glob would hide orphaned scripts.
    "scripts/check-test-skips.mjs",
    "scripts/census-builder-run.mjs",
    "scripts/census-boundaries.mjs",
    "scripts/check-enforced-by.mjs",
    "scripts/codemods/error-code-to-failure.mjs",
    "scripts/keycloak-refresh-probe.mjs",
    "scripts/builder-eval/plan-bench.mjs",
    "scripts/builder-eval/experiment.mjs",
    "scripts/builder-eval/sankhya-sim.mjs",
    "scripts/builder-eval/serve.mjs",
    "tests/**/*.test.mjs",
    // Test-support files that are run or loaded but never imported. Name each one: a directory glob
    // here would hide orphaned helpers (tests/repository/knip-config.test.mjs guards both lists).
    "tests/live/harness.mjs",
    "tests/live/hub-entry.mjs",
    "tests/implementation/check-lock-child.mjs",
    "tests/implementation/builder-google-ai-pro-fake-cliproxy.mjs",
    "tests/implementation/sandbox-probe/network_egress.mjs",
    "tests/implementation/sandbox-probe/read_proc.mjs",
    "tests/implementation/sandbox-probe/read_secrets.mjs",
    "tests/implementation/sandbox-probe/walk_fs.mjs",
    "tests/fixtures/admission-negative.ts",
    "tests/fixtures/census-boundaries/pg-rows.ts",
    "tests/fixtures/census-boundaries/web-json.ts",
    // Bundled as text into the check by scripts/build-app-check.mjs, which writes it into each Project as conexus/sankhya.gen.ts.
    "apps/hub/src/builder/handler-kit/sankhya.ts",
    // The application check's bundle starts here; the Hub itself imports only its report module.
    "apps/hub/src/builder/check/main.ts",
    "apps/hub/src/server.ts",
    "apps/hub/src/app-runner/main.ts",
    "apps/hub/src/telemetry/register.ts",
    "apps/web/src/main.tsx",
    "apps/web/src/app/foreign.ts",
    "apps/web/src/app/route-params.ts",
    "packages/contract/src/index.ts",
    "apps/hub/compiler-template/**",
    // The Builder skills' reference screens are read as text and copied into each Project.
    "builder-skills/**/*.tsx",
    // The verify skill's drivers are run by the skill, never imported.
    ".agents/skills/verify/scripts/control.mjs",
    ".agents/skills/verify/scripts/fake-cliproxy.mjs"
  ],
  "project": ["apps/hub/src/**", "apps/web/src/**", "packages/**/src/**", "!packages/**/src/**/*.d.mts", "scripts/**", "!scripts/fixtures/**", "tests/**", "builder-skills/**/*.tsx", ".agents/**/*.mjs", "!.agents/skills/mastra/**"],
  "ignore": ["apps/hub/src/generated/**", "apps/web/src/generated/**", "apps/hub/src/platform/hub-roles.generated.ts"],
  // @mastra/playground-ui publishes .d.ts files importing class-variance-authority but lists it
  // only as its own devDependency; our pin supplies those types for the web typecheck.
  // conexus-verify.mjs runs biome as a string command, which knip cannot see.
  "ignoreDependencies": [
    "class-variance-authority",
    "@biomejs/biome"
  ],
  // The reference screens import the generated app's own components and libraries, which this package does not install.
  "ignoreIssues": {
    "builder-skills/**": ["unlisted", "unresolved"],
    // Frozen by spec 0015 section 3: the web caller's query and href are first used by the parts that declare GET operations.
    "apps/web/src/app/http.ts": ["exports"],
    // Frozen by spec 0015 section 3: the table each part extends with its own constraints, read by the data test on the built Hub.
    "apps/hub/src/platform/db.ts": ["exports"],
    // Frozen by spec 0015 section 3: reserve and complete are first called by project creation in part 3.
    "apps/hub/src/platform/receipt.ts": ["exports", "types"],
    // Frozen by spec 0015 section 3: the scope, action and role tables that parts 3 to 6 admit through.
    "apps/hub/src/identity-access/admission.ts": ["exports", "types"]
  },
  "ignoreBinaries": ["setpriv", "pgrep"]
}
