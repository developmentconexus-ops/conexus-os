{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**",
      "!apps/keycloak-theme",
      "packages/**",
      "scripts/**",
      "tests/**",
      "!apps/**/src/generated",
      "!!apps/**/public",
      "!!**/dist",
      "!!**/coverage"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": ["apps/hub/src/identity-access/routes.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noImplicitAnyLet": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/main.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noAutofocus": "off",
            "noStaticElementInteractions": "off",
            "useButtonType": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/hub/src/**", "apps/web/src/**", "packages/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "error"
          }
        }
      }
    },
    {
      "includes": ["scripts/builder-eval/checks.mjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noControlCharactersInRegex": "off"
          }
        }
      }
    }
  ]
}
