{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**",
      "!apps/keycloak-theme",
      "!apps/hub/starter-template",
      "packages/**",
      "scripts/**",
      "tests/**",
      ".agents/**",
      "!.agents/skills/mastra",
      "builder-skills/**/*.tsx",
      "!apps/**/src/generated",
      "!!apps/**/public",
      "!!**/dist",
      "!!**/coverage"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      },
      "nursery": {
        "useExhaustiveSwitchCases": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": ["apps/hub/src/**"],
      "plugins": ["./biome/plugins/no-error-code.grit"]
    },
    {
      "includes": ["apps/hub/src/**", "!apps/hub/src/platform/db.ts", "!apps/hub/src/app-runner/data-plane.ts"],
      "plugins": ["./biome/plugins/no-session-setting-in-sql.grit"]
    },
    {
      "includes": [
        "apps/web/src/**",
        "packages/*/src/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/hub/src/**",
        "apps/web/src/**",
        "packages/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/*/src/**",
        "packages/*/src/**"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noUnsafeTypeAssertion": "error"
          },
          "suspicious": {
            "noEmptyBlockStatements": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/**",
        "!apps/hub/src/platform/db.ts",
        "!apps/hub/src/app-runner/worker.ts",
        "!apps/hub/src/app-runner/supervisor.ts",
        "!apps/hub/src/builder/store.ts",
        "!apps/hub/src/connectors/store.ts",
        "!apps/hub/src/identity-access/application-access.ts",
        "!apps/hub/src/identity-access/host-sessions.ts",
        "!apps/hub/src/identity-access/installation-administration.ts",
        "!apps/hub/src/identity-access/store.ts",
        "!apps/hub/src/project/deletion.ts",
        "!apps/hub/src/project/store.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pg": "Only the database edge may import pg."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/*/src/**",
        "packages/*/src/**",
        "scripts/**",
        ".agents/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 80
              }
            }
          },
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 500
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/*/src/**",
        "packages/*/src/**",
        "!apps/hub/src/identity-access/admission.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/tests/**", "**/scripts/**"],
                    "message": "Production code cannot import tests or scripts."
                  },
                  {
                    "group": ["**/platform/db", "**/platform/db.js"],
                    "importNamePattern": "openGate",
                    "message": "A gate is opened only by identity-access/admission.ts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/*/src/**",
        "!apps/hub/src/identity-access/admission.ts",
        "!apps/hub/src/platform/db.ts",
        "!apps/hub/src/app-runner/worker.ts",
        "!apps/hub/src/app-runner/supervisor.ts",
        "!apps/hub/src/builder/store.ts",
        "!apps/hub/src/connectors/store.ts",
        "!apps/hub/src/identity-access/application-access.ts",
        "!apps/hub/src/identity-access/host-sessions.ts",
        "!apps/hub/src/identity-access/installation-administration.ts",
        "!apps/hub/src/identity-access/store.ts",
        "!apps/hub/src/project/deletion.ts",
        "!apps/hub/src/project/store.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pg": "Only the database edge may import pg."
                },
                "patterns": [
                  {
                    "group": ["**/tests/**", "**/scripts/**"],
                    "message": "Production code cannot import tests or scripts."
                  },
                  {
                    "group": ["**/platform/db", "**/platform/db.js"],
                    "importNamePattern": "openGate",
                    "message": "A gate is opened only by identity-access/admission.ts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/hub/src/identity-access/admission.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pg": "Only the database edge may import pg."
                },
                "patterns": [
                  {
                    "group": ["**/tests/**", "**/scripts/**"],
                    "message": "Production code cannot import tests or scripts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/**",
        "!apps/web/src/app/http.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "Principle 6: call the Hub through hubFetch in app/http.ts."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/hub/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "setInterval": "Periodic work is a Job run by startJobs in platform/jobs.ts (spec 0013)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/hub/src/**",
        "!apps/hub/src/platform/config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/hub/src/telemetry/log-codes.generated.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": [
        ".agents/skills/verify/scripts/control.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 563
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/features/builder/transcript.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 615
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "scripts/builder-eval/run.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 826
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "scripts/conexus-verify.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 684
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/**",
        "!apps/web/src/app/failure.ts",
        "!apps/web/src/features/builder/construir/run-failure.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/app/failure",
                      "**/app/failure.ts"
                    ],
                    "importNamePattern": "failureCodeText",
                    "message": "A settled run's failure is said once, by RunFailure. Read the code there, nowhere else."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
