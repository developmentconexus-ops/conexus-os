{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**",
      "!apps/keycloak-theme",
      "!apps/hub/starter-template",
      "packages/**",
      "scripts/**",
      "tests/**",
      ".agents/**",
      "!.agents/skills/mastra",
      "builder-skills/**/*.tsx",
      "!apps/**/src/generated",
      "!!apps/**/public",
      "!!**/dist",
      "!!**/coverage"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      },
      "nursery": {
        "useExhaustiveSwitchCases": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": ["apps/hub/src/**"],
      "plugins": ["./biome/plugins/no-error-code.grit"]
    },
    {
      "includes": [
        "apps/web/src/**",
        "packages/*/src/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/hub/src/**",
        "apps/web/src/**",
        "packages/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/*/src/**",
        "packages/*/src/**"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noUnsafeTypeAssertion": "error"
          },
          "suspicious": {
            "noEmptyBlockStatements": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/*/src/**",
        "packages/*/src/**",
        "scripts/**",
        ".agents/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 80
              }
            }
          },
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 500
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/**",
        "!apps/web/src/app/http.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "Principle 6: call the Hub through hubFetch in app/http.ts."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/hub/src/**",
        "!apps/hub/src/platform/config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error"
          }
        }
      }
    },
    {
      "includes": [
        ".agents/skills/verify/scripts/control.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 563
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/hub/src/builder/run-runtime.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 974
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/features/builder/transcript.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 619
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "scripts/builder-eval/run.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 826
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "scripts/conexus-verify.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 684
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/*/src/**",
        "packages/*/src/**"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noUnsafeTypeAssertion": "error"
          },
          "suspicious": {
            "noEmptyBlockStatements": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/*/src/**",
        "packages/*/src/**",
        "scripts/**",
        ".agents/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 80
              }
            }
          },
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 500
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/**",
        "!apps/web/src/app/http.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "Principle 6: call the Hub through hubFetch in app/http.ts."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/hub/src/**",
        "!apps/hub/src/platform/config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error"
          }
        }
      }
    },
    {
      "includes": [
        ".agents/skills/verify/scripts/control.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 563
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/hub/src/builder/run-runtime.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 974
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/features/builder/transcript.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 619
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "scripts/builder-eval/run.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 826
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "scripts/conexus-verify.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 684
              }
            }
          }
        }
      }
    }
  ]
}
