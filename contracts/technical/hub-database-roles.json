{
  "$comment": "Every Hub connection role is registered here. The Hub logs in as hub_runtime and switches each transaction to a transaction role; hub_factory is for Mastra storage. Capability roles remain only while their SQL owners are ported.",
  "roles": [
    {
      "role": "hub_runtime",
      "capability": "hub-data",
      "passwordFileVariable": "CONEXUS_DB_PASSWORD_FILE",
      "roleVariable": "CONEXUS_DB_USER",
      "connectsFrom": [
        "apps/hub/src/hub.ts"
      ],
      "settings": {
        "lock_timeout": "5s",
        "statement_timeout": "30s",
        "idle_in_transaction_session_timeout": "60s"
      }
    },
    {
      "role": "hub_iam_runtime",
      "capability": "identity-and-access",
      "passwordFileVariable": "CONEXUS_DB_IAM_RUNTIME_PASSWORD_FILE",
      "connectsFrom": [],
      "legacy": true
    },
    {
      "role": "hub_builder_ingress",
      "capability": "builder-request",
      "passwordFileVariable": "CONEXUS_DB_BUILDER_INGRESS_PASSWORD_FILE",
      "connectsFrom": [],
      "legacy": true
    },
    {
      "role": "hub_builder_executor",
      "capability": "builder-run-execution",
      "passwordFileVariable": "CONEXUS_DB_BUILDER_EXECUTOR_PASSWORD_FILE",
      "connectsFrom": [],
      "legacy": true
    },
    {
      "role": "hub_model_account",
      "capability": "model-account",
      "passwordFileVariable": "CONEXUS_DB_MODEL_ACCOUNT_PASSWORD_FILE",
      "connectsFrom": [],
      "legacy": true
    },
    {
      "role": "hub_factory",
      "capability": "factory-storage",
      "passwordFileVariable": "CONEXUS_DB_FACTORY_PASSWORD_FILE",
      "optional": true,
      "connectsFrom": [
        "apps/hub/src/builder/module.ts"
      ]
    }
  ],
  "policyRoles": [
    {
      "role": "iam_rls",
      "owns": [
        "rls.acting_account",
        "rls.acting_installation_administrator",
        "rls.acting_workspaces"
      ],
      "privileges": [
        "SELECT"
      ]
    }
  ],
  "ownerRoles": [
    "iam_owner",
    "workspace_owner",
    "project_owner",
    "registry_owner",
    "builder_owner",
    "connector_owner",
    "model_owner",
    "conexus_owner"
  ],
  "transactionRoles": [
    {
      "role": "hub_reader",
      "purpose": "a person's read: SELECT under the reader policies"
    },
    {
      "role": "hub_command",
      "purpose": "a command: the verbs the table register names, under its proof"
    }
  ]
}
