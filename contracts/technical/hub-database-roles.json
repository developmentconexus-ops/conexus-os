{
  "$comment": "Every Hub connection role is registered here. The runtime uses hub_runtime for Hub data and hub_factory for Mastra storage; capability roles remain only while their SQL owners are ported.",
  "roles": [
    {
      "role": "hub_runtime",
      "capability": "hub-data",
      "passwordFileVariable": "CONEXUS_DB_PASSWORD_FILE",
      "roleVariable": "CONEXUS_DB_USER",
      "connectsFrom": [
        "apps/hub/src/hub.ts"
      ]
    },
    {
      "role": "hub_iam_runtime",
      "capability": "identity-and-access",
      "passwordFileVariable": "CONEXUS_DB_IAM_RUNTIME_PASSWORD_FILE",
      "connectsFrom": [],
      "legacy": true
    },
    {
      "role": "hub_project_read",
      "capability": "project-read",
      "passwordFileVariable": "CONEXUS_DB_PROJECT_READ_PASSWORD_FILE",
      "connectsFrom": [],
      "legacy": true
    },
    {
      "role": "hub_project_command",
      "capability": "project-command",
      "passwordFileVariable": "CONEXUS_DB_PROJECT_COMMAND_PASSWORD_FILE",
      "connectsFrom": [],
      "legacy": true
    },
    {
      "role": "hub_builder_ingress",
      "capability": "builder-request",
      "passwordFileVariable": "CONEXUS_DB_BUILDER_INGRESS_PASSWORD_FILE",
      "connectsFrom": [],
      "legacy": true
    },
    {
      "role": "hub_builder_executor",
      "capability": "builder-run-execution",
      "passwordFileVariable": "CONEXUS_DB_BUILDER_EXECUTOR_PASSWORD_FILE",
      "connectsFrom": [],
      "legacy": true
    },
    {
      "role": "hub_model_account",
      "capability": "model-account",
      "passwordFileVariable": "CONEXUS_DB_MODEL_ACCOUNT_PASSWORD_FILE",
      "connectsFrom": [],
      "legacy": true
    },
    {
      "role": "hub_factory",
      "capability": "factory-storage",
      "passwordFileVariable": "CONEXUS_DB_FACTORY_PASSWORD_FILE",
      "optional": true,
      "connectsFrom": [
        "apps/hub/src/builder/module.ts"
      ]
    }
  ],
  "policyRoles": [
    {
      "role": "iam_rls",
      "owns": [
        "iam.acting_account",
        "iam.acting_applications",
        "iam.acting_installation_administrator",
        "iam.acting_scope",
        "iam.acting_workspaces"
      ],
      "privileges": [
        "SELECT"
      ]
    }
  ],
  "ownerRoles": [
    "iam_owner",
    "workspace_owner",
    "project_owner",
    "registry_owner",
    "builder_owner",
    "connector_owner",
    "model_owner",
    "conexus_owner"
  ]
}
