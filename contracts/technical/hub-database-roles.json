{
  "$comment": "Every Hub connection role is registered here. Person reads and commands use hub_runtime with scoped admission proofs; hub_factory is for Mastra storage.",
  "roles": [
    {
      "role": "hub_runtime",
      "capability": "hub-data",
      "passwordFileVariable": "CONEXUS_DB_PASSWORD_FILE",
      "roleVariable": "CONEXUS_DB_USER",
      "connectsFrom": [
        "apps/hub/src/hub.ts"
      ],
      "settings": {
        "lock_timeout": "5s",
        "statement_timeout": "30s",
        "idle_in_transaction_session_timeout": "60s"
      }
    },
    {
      "role": "hub_factory",
      "capability": "factory-storage",
      "passwordFileVariable": "CONEXUS_DB_FACTORY_PASSWORD_FILE",
      "optional": true,
      "connectsFrom": [
        "apps/hub/src/builder/module.ts"
      ]
    }
  ],
  "ownerRoles": [
    "conexus_owner"
  ]
}
