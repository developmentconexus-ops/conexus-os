{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conexus:schema:project-operation:v1",
  "title": "Conexus Project Operation Declaration",
  "description": "Canonical 4B declaration grammar for one exact Release-pinned Project operation. A valid declaration is not runtime authority by itself; it becomes authoritative only inside an admitted exact Project Release contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "regime",
    "inputSchema",
    "outputSchema",
    "callers",
    "scope",
    "requiredPins",
    "effectClass",
    "outcomeProfile",
    "icProfiles",
    "proof"
  ],
  "properties": {
    "schemaVersion": {
      "const": "project-operation/v1"
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
      "description": "Exact Release-admitted semantic operation identity and generated OpenAPI operationId."
    },
    "regime": {
      "enum": ["QUERY", "ACTION", "INTEGRATION"]
    },
    "inputSchema": {
      "$ref": "#/$defs/exactPayloadSchema"
    },
    "outputSchema": {
      "$ref": "#/$defs/exactPayloadSchema"
    },
    "callers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/publishedAppCaller" },
          { "$ref": "#/$defs/parToolCaller" },
          { "$ref": "#/$defs/marJobCaller" },
          { "$ref": "#/$defs/controlPlaneCaller" },
          { "$ref": "#/$defs/dedicatedServiceCaller" }
        ]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "project", "publishedApp"],
      "properties": {
        "workspace": { "const": "CURRENT_WORKSPACE" },
        "project": { "const": "CURRENT_PROJECT" },
        "publishedApp": {
          "enum": ["NONE", "CURRENT_PROJECT_APP"]
        }
      }
    },
    "requiredPins": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ACTIVE_RELEASE",
          "PROJECT_BRAIN_BINDING",
          "PROJECT_CONNECTION_BINDING",
          "CONNECTION_REVISION",
          "ENVIRONMENT",
          "CURATED_DATASET",
          "PAR_TOOL_PROJECTION",
          "MAR_JOB_PROJECTION"
        ]
      }
    },
    "effectClass": {
      "enum": ["READ_ONLY", "OWNER_STATE_CHANGE", "EXTERNAL_EFFECT"]
    },
    "outcomeProfile": {
      "enum": [
        "READ",
        "PROVENANCE_READ",
        "COMMAND",
        "DECISION",
        "CONSEQUENTIAL",
        "ANALYTIC",
        "PROOF"
      ]
    },
    "icProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["IC0", "IC1", "IC2", "IC3", "IC4"]
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positiveCaseId", "negativeControlId"],
      "properties": {
        "positiveCaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "negativeControlId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "regime": { "const": "QUERY" } },
        "required": ["regime"]
      },
      "then": {
        "properties": {
          "effectClass": { "const": "READ_ONLY" },
          "icProfiles": { "const": ["IC0"] }
        }
      }
    },
    {
      "if": {
        "properties": { "regime": { "const": "INTEGRATION" } },
        "required": ["regime"]
      },
      "then": {
        "properties": {
          "requiredPins": {
            "allOf": [
              { "contains": { "const": "PROJECT_CONNECTION_BINDING" } },
              { "contains": { "const": "CONNECTION_REVISION" } }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "effectClass": { "const": "EXTERNAL_EFFECT" } },
        "required": ["effectClass"]
      },
      "then": {
        "properties": {
          "icProfiles": {
            "contains": { "const": "IC4" }
          }
        }
      }
    }
  ],
  "$defs": {
    "exactPayloadSchema": {
      "allOf": [
        { "$ref": "https://json-schema.org/draft/2020-12/schema" },
        {
          "type": "object",
          "anyOf": [
            { "required": ["$ref"] },
            { "required": ["$dynamicRef"] },
            { "required": ["type"] },
            { "required": ["const"] },
            { "required": ["enum"] },
            { "required": ["oneOf"] },
            { "required": ["anyOf"] },
            { "required": ["allOf"] },
            { "required": ["not"] }
          ]
        }
      ]
    },
    "publishedAppCaller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "roles"],
      "properties": {
        "kind": { "const": "PUBLISHED_APP" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["admin", "member"] }
        }
      }
    },
    "parToolCaller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "PAR_TOOL" }
      }
    },
    "marJobCaller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "MAR_JOB" }
      }
    },
    "controlPlaneCaller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "permission"],
      "properties": {
        "kind": { "const": "CONTROL_PLANE" },
        "permission": {
          "enum": [
            "workspace.manage",
            "workspace.access.manage",
            "project.create",
            "project.read",
            "project.source.read",
            "project.data.read",
            "project.build",
            "project.review",
            "release.promote",
            "job.run",
            "audit.read",
            "brain.read",
            "brain.propose",
            "brain.discover",
            "brain.review",
            "brain.publish",
            "brain.bind",
            "connection.read",
            "connection.manage",
            "connection.qualify",
            "connection.use",
            "agent.trigger.manage",
            "agent.headless.invoke",
            "agent.effect.approve"
          ]
        }
      }
    },
    "dedicatedServiceCaller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "serviceId"],
      "properties": {
        "kind": { "const": "DEDICATED_SERVICE_SCOPED" },
        "serviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        }
      }
    }
  }
}
