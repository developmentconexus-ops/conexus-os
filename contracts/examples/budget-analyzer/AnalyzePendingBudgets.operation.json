{
  "schemaVersion": "project-operation/v1",
  "operationId": "AnalyzePendingBudgets",
  "regime": "QUERY",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "filters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sellerIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "customerIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "agingBands": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["AGE_0_3", "AGE_4_7", "AGE_8_30", "AGE_31_PLUS"]
            }
          },
          "calendarMonths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            }
          },
          "sourceCompanyIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["truth"],
    "properties": {
      "truth": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "asOf", "freshness", "coverage", "provenance"],
        "properties": {
          "state": {
            "enum": [
              "SUPPORTED_CURRENT",
              "SUPPORTED_STALE",
              "PARTIAL",
              "UNVERIFIED",
              "INDETERMINATE",
              "UNSUPPORTED",
              "DEPENDENCY_UNAVAILABLE"
            ]
          },
          "asOf": {
            "type": "string",
            "minLength": 1,
            "readOnly": true,
            "description": "Opaque system-issued source/reconciliation coordinate; never caller-selected historical input."
          },
          "freshness": { "enum": ["CURRENT", "STALE", "UNKNOWN"] },
          "coverage": { "enum": ["COMPLETE", "PARTIAL", "UNKNOWN"] },
          "provenance": { "enum": ["VERIFIED", "PARTIAL", "UNVERIFIED"] }
        }
      },
      "currencyCode": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "readOnly": true,
        "description": "ISO 4217 unit applying to every monetary value in this response. Mixed-currency aggregation is not admitted by F1."
      },
      "summary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pendingBudgetCount", "pendingBudgetValue"],
        "properties": {
          "pendingBudgetCount": { "type": "integer", "minimum": 0 },
          "pendingBudgetValue": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          }
        }
      },
      "bySeller": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sellerId", "sellerName", "budgetCount", "budgetValue", "averageBudgetAgeDays"],
          "properties": {
            "sellerId": { "type": "string", "minLength": 1 },
            "sellerName": { "type": "string", "minLength": 1 },
            "budgetCount": { "type": "integer", "minimum": 0 },
            "budgetValue": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
            "averageBudgetAgeDays": { "type": "number", "minimum": 0 }
          }
        }
      },
      "byCustomer": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["customerId", "customerName", "budgetCount", "budgetValue", "averageBudgetAgeDays"],
          "properties": {
            "customerId": { "type": "string", "minLength": 1 },
            "customerName": { "type": "string", "minLength": 1 },
            "budgetCount": { "type": "integer", "minimum": 0 },
            "budgetValue": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
            "averageBudgetAgeDays": { "type": "number", "minimum": 0 }
          }
        }
      },
      "byAgingBand": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agingBand", "budgetCount", "budgetValue"],
          "properties": {
            "agingBand": { "enum": ["AGE_0_3", "AGE_4_7", "AGE_8_30", "AGE_31_PLUS"] },
            "budgetCount": { "type": "integer", "minimum": 0 },
            "budgetValue": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" }
          }
        }
      },
      "byMonth": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["calendarMonth", "budgetCount", "budgetValue"],
          "properties": {
            "calendarMonth": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
            "budgetCount": { "type": "integer", "minimum": 0 },
            "budgetValue": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" }
          }
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "truth": {
              "properties": {
                "state": { "enum": ["SUPPORTED_CURRENT", "SUPPORTED_STALE"] }
              },
              "required": ["state"]
            }
          },
          "required": ["truth"]
        },
        "then": {
          "required": ["currencyCode", "summary", "bySeller", "byCustomer", "byAgingBand", "byMonth"]
        }
      },
      {
        "if": {
          "anyOf": [
            { "required": ["summary"] },
            { "required": ["bySeller"] },
            { "required": ["byCustomer"] },
            { "required": ["byAgingBand"] },
            { "required": ["byMonth"] }
          ]
        },
        "then": { "required": ["currencyCode"] }
      },
      {
        "if": {
          "properties": {
            "truth": {
              "properties": {
                "state": { "enum": ["UNVERIFIED", "INDETERMINATE", "UNSUPPORTED", "DEPENDENCY_UNAVAILABLE"] }
              },
              "required": ["state"]
            }
          },
          "required": ["truth"]
        },
        "then": {
          "not": {
            "anyOf": [
              { "required": ["summary"] },
              { "required": ["bySeller"] },
              { "required": ["byCustomer"] },
              { "required": ["byAgingBand"] },
              { "required": ["byMonth"] }
            ]
          }
        }
      }
    ]
  },
  "callers": [
    {
      "kind": "PUBLISHED_APP",
      "roles": ["admin", "member"]
    }
  ],
  "scope": {
    "workspace": "CURRENT_WORKSPACE",
    "project": "CURRENT_PROJECT",
    "publishedApp": "CURRENT_PROJECT_APP"
  },
  "requiredPins": [
    "ACTIVE_RELEASE",
    "PROJECT_BRAIN_BINDING",
    "PROJECT_CONNECTION_BINDING",
    "CONNECTION_REVISION"
  ],
  "effectClass": "READ_ONLY",
  "outcomeProfile": "ANALYTIC",
  "icProfiles": ["IC0"],
  "proof": {
    "positiveCaseId": "budget-analyzer-r1-r5-supported-snapshot",
    "negativeControlId": "budget-analyzer-excluded-non-budget-operation"
  }
}
