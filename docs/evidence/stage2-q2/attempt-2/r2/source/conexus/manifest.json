{
  "operations": {
    "listNotes": {
      "handler": "handlers/notes.ts",
      "export": "listNotes",
      "input": {
        "type": "object",
        "properties": {
          "orderNumber": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": ["orderNumber"],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "maxItems": 500,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "orderNumber": {
              "type": "string",
              "maxLength": 100
            },
            "note": {
              "type": "string",
              "maxLength": 5000
            },
            "author": {
              "type": "string",
              "maxLength": 100
            },
            "status": {
              "type": "string",
              "maxLength": 50
            },
            "createdAt": {
              "type": "string",
              "maxLength": 100
            }
          },
          "required": ["id", "orderNumber", "note", "author", "status", "createdAt"],
          "additionalProperties": false
        }
      }
    },
    "addNote": {
      "handler": "handlers/notes.ts",
      "export": "addNote",
      "input": {
        "type": "object",
        "properties": {
          "orderNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "author": {
            "type": "string",
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "maxLength": 50
          }
        },
        "required": ["orderNumber", "note", "author"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "orderNumber": {
            "type": "string",
            "maxLength": 100
          },
          "note": {
            "type": "string",
            "maxLength": 5000
          },
          "author": {
            "type": "string",
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "maxLength": 50
          },
          "createdAt": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": ["id", "orderNumber", "note", "author", "status", "createdAt"],
        "additionalProperties": false
      }
    },
    "updateNoteStatus": {
      "handler": "handlers/notes.ts",
      "export": "updateNoteStatus",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "maxLength": 50
          }
        },
        "required": ["id", "status"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "orderNumber": {
            "type": "string",
            "maxLength": 100
          },
          "note": {
            "type": "string",
            "maxLength": 5000
          },
          "author": {
            "type": "string",
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "maxLength": 50
          },
          "createdAt": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": ["id", "orderNumber", "note", "author", "status", "createdAt"],
        "additionalProperties": false
      }
