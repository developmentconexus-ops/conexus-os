{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git worktree prune*)",
      "PowerShell(git worktree prune*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(git clean*)",
      "PowerShell(git clean*)",
      "Bash(git stash*)",
      "PowerShell(git stash*)",
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push * --force*)",
      "PowerShell(git push * --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git push * -f*)",
      "PowerShell(git push * -f*)",
      "Bash(git push * main)",
      "PowerShell(git push * main)",
      "Bash(git push * main *)",
      "PowerShell(git push * main *)",
      "Bash(git push *:main*)",
      "PowerShell(git push *:main*)"
    ],
    "ask": [
      "Bash(gh pr merge*)",
      "PowerShell(gh pr merge*)",
      "Bash(*infra/pilot/*)",
      "PowerShell(*infra/pilot/*)",
      "Bash(*infra/keycloak/*)",
      "PowerShell(*infra/keycloak/*)",
      "Bash(*run-application-cluster*)",
      "PowerShell(*run-application-cluster*)",
      "Bash(*mount-application-cluster-storage*)",
      "PowerShell(*mount-application-cluster-storage*)",
      "Bash(*run-hub-migrations*)",
      "PowerShell(*run-hub-migrations*)",
      "Bash(*conexus-pilot*)",
      "PowerShell(*conexus-pilot*)",
      "Bash(*hub.env*)",
      "PowerShell(*hub.env*)",
      "Bash(*runner.env*)",
      "PowerShell(*runner.env*)",
      "Bash(*kill *)",
      "PowerShell(*kill *)",
      "Bash(*pkill *)",
      "PowerShell(*pkill *)",
      "Bash(*docker *conexus-*)",
      "PowerShell(*docker *conexus-*)"
    ]
  }
}
