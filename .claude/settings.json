{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git worktree prune*)",
      "PowerShell(git worktree prune*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(git clean*)",
      "PowerShell(git clean*)",
      "Bash(git stash*)",
      "PowerShell(git stash*)",
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push * --force*)",
      "PowerShell(git push * --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git push * -f*)",
      "PowerShell(git push * -f*)",
      "Bash(git push * main)",
      "PowerShell(git push * main)",
      "Bash(git push * main *)",
      "PowerShell(git push * main *)",
      "Bash(git push *:main*)",
      "PowerShell(git push *:main*)",
      "Bash(docker rm *)",
      "PowerShell(docker rm *)",
      "Bash(docker container rm *)",
      "PowerShell(docker container rm *)"
    ],
    "ask": [
      "Bash(gh pr merge*)",
      "PowerShell(gh pr merge*)",
      "Bash(bash infra/pilot/*)",
      "PowerShell(bash infra/pilot/*)",
      "Bash(infra/pilot/*)",
      "PowerShell(infra/pilot/*)",
      "Bash(./infra/pilot/*)",
      "PowerShell(./infra/pilot/*)",
      "Bash(bash infra/keycloak/*)",
      "PowerShell(bash infra/keycloak/*)",
      "Bash(infra/keycloak/*)",
      "PowerShell(infra/keycloak/*)",
      "Bash(./infra/keycloak/*)",
      "PowerShell(./infra/keycloak/*)",
      "Bash(bash scripts/run-application-cluster.sh*)",
      "PowerShell(bash scripts/run-application-cluster.sh*)",
      "Bash(scripts/run-application-cluster.sh*)",
      "PowerShell(scripts/run-application-cluster.sh*)",
      "Bash(./scripts/run-application-cluster.sh*)",
      "PowerShell(./scripts/run-application-cluster.sh*)",
      "Bash(bash scripts/mount-application-cluster-storage.sh*)",
      "PowerShell(bash scripts/mount-application-cluster-storage.sh*)",
      "Bash(scripts/mount-application-cluster-storage.sh*)",
      "PowerShell(scripts/mount-application-cluster-storage.sh*)",
      "Bash(./scripts/mount-application-cluster-storage.sh*)",
      "PowerShell(./scripts/mount-application-cluster-storage.sh*)",
      "Bash(sudo bash scripts/mount-application-cluster-storage.sh*)",
      "PowerShell(sudo bash scripts/mount-application-cluster-storage.sh*)",
      "Bash(node scripts/run-hub-migrations.mjs*)",
      "PowerShell(node scripts/run-hub-migrations.mjs*)",
      "Bash(docker * conexus-*)",
      "PowerShell(docker * conexus-*)",
      "Bash(git -C *conexus-pilot *)",
      "PowerShell(git -C *conexus-pilot *)",
      "Bash(git -C *conexus-pilot/ *)",
      "PowerShell(git -C *conexus-pilot/ *)",
      "Bash(cd *conexus-pilot)",
      "PowerShell(cd *conexus-pilot)",
      "Bash(cd *conexus-pilot/*)",
      "PowerShell(cd *conexus-pilot/*)"
    ]
  }
}
