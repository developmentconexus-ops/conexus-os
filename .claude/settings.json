{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git worktree prune*)",
      "PowerShell(git worktree prune*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(git clean*)",
      "PowerShell(git clean*)",
      "Bash(git stash*)",
      "PowerShell(git stash*)",
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push * --force*)",
      "PowerShell(git push * --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git push * -f*)",
      "PowerShell(git push * -f*)",
      "Bash(git push * main)",
      "PowerShell(git push * main)",
      "Bash(git push * main *)",
      "PowerShell(git push * main *)",
      "Bash(git push *:main*)",
      "PowerShell(git push *:main*)",
      "Bash(gh pr merge*)",
      "PowerShell(gh pr merge*)",
      "Bash(docker rm *)",
      "PowerShell(docker rm *)",
      "Bash(docker container rm *)",
      "PowerShell(docker container rm *)"
    ]
  }
}
